{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "18.20.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "18.20.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.153:3000"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "18.20.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.153:3000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}