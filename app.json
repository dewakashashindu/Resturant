{
  "expo": {
    "name": "Restaurant",
    "slug": "Restarurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appiconw.png",
    "scheme": "resturant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appiconw.png"
      },
      "package": "com.dewaka_shashindu.Restarurant"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/appiconw.png",
          "imageWidth": 500,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0a7a081-4c8f-4c60-b7fc-11bd26478287"
      }
    },
    "owner": "dewaka_shashindu"
  }
}
