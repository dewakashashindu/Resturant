{
  "expo": {
    "name": "Mila Mirissa",
    "slug": "Restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/millamirissa-app-icon.png",
    "scheme": "restaurant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/millamirissa-adaptive.png",
        "backgroundColor": "#FFF9F4"
      },
      "package": "com.dewaka_shashindu.Restaurant"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/millamirissa.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F4"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Mila Mirissa to use Face ID for secure sign in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/millamirissa-notification.png",
          "color": "#6F5434",
          "sounds": ["./assets/sounds/notification_chime.wav"]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Mila Mirissa to access the microphone for voice queries.",
          "speechRecognitionPermission": "Allow Mila Mirissa to use speech recognition to analyze sales data."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0a7a081-4c8f-4c60-b7fc-11bd26478287"
      }
    },
    "owner": "dewaka_shashindu"
  }
}